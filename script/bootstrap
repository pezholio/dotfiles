#!/bin/bash
set -euo pipefail

if [[ -z "${ZSH+x}" ]]; then
  echo "Installing ohmyzsh.."
  curl -fsSL https://raw.github.com/robbyrussell/oh-my-zsh/master/tools/install.sh | sh
fi

if ! command -v brew >/dev/null 2>&1; then
  echo "Installing Homebrew..."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

echo "Installing Homebrew dependencies from Brewfile..."
brew bundle install --verbose --quiet

echo "Setting MacOS defaults..."
/bin/bash -c "$("$HOME/.dotfiles/macos/set-defaults.sh")"

echo "Creating secrets file (if it doesn't exist)..."
if [ ! -f "$HOME/.dotfiles/secrets.sh" ]; then
  cat << EOF > "$HOME/.dotfiles/secrets.sh"
# Add your secrets here, for example:
# export GITHUB_TOKEN="your_github_token"
EOF
fi

echo "Symlinking Ghostty config..."
ln -sfn "$HOME/.dotfiles/ghostty" "$HOME/.config/ghostty"

zshrc_source="source "$HOME/.dotfiles/.zshrc""
grep -Fqx "$zshrc_source" "$HOME/.zshrc" ||
  printf '%s\n' "$zshrc_source" >> "$HOME/.zshrc"