#!/bin/bash
set -euo pipefail

if [[ -z "${ZSH+x}" ]]; then
  echo "Installing ohmyzsh.."
  curl -fsSL https://raw.github.com/robbyrussell/oh-my-zsh/master/tools/install.sh | sh
fi

if ! command -v brew >/dev/null 2>&1; then
  echo "Installing Homebrew..."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

echo "Installing Homebrew dependencies from Brewfile..."
brew bundle install --verbose --quiet

echo "Hiding desktop icons..."
defaults write com.apple.finder CreateDesktop false
killall Finder

echo "Setting desktop images..."
echo "Setting desktop images..."
if desktoppr 1 "$HOME/.dotfiles/wallpaper/jazzcats.jpg"; then
  desktoppr 0 "$HOME/.dotfiles/wallpaper/benny.jpg"
else
  desktoppr 0 "$HOME/.dotfiles/wallpaper/jazzcats.jpg"
fi

echo "Setting keymappings..."
mkdir -p "$HOME/.config"
ln -sfn "$HOME/.dotfiles/karabiner" "$HOME/.config/karabiner"

zshrc_source="source "$HOME/.dotfiles/.zshrc""
grep -Fqx "$zshrc_source" "$HOME/.zshrc" ||
  printf '%s\n' "$zshrc_source" >> "$HOME/.zshrc"